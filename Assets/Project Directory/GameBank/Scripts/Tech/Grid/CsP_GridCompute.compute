#pragma kernel BakeCollision
#pragma kernel GridCompute

RWTexture2D<float4> Result; // R=illum, G=vis, B=collision, A=1
RWTexture2D<float4> CollisionRT; // BakeCollision writes here (G channel)

Texture2D<float4> CollisionMask;

float4 PlayerPos; // x=worldX, z=worldZ (we'll use .x and .z)
float4 PlayerForward; // x=forwardX, z=forwardZ

float GridPosX;
float GridPosZ;
float VisibilityRadius;
float VisibilityEdgeStart;
float PlayerCellEdgeSmooth; // 0..1
float WorldSubW;
int Subdiv;
float PlayerIllumBleed;

// front cell provided from C#
int FrontCellX;
int FrontCellY;

// Bake inputs
StructuredBuffer<float4> Colliders; // x=centerX, y=centerZ, z=halfExtX, w=halfExtZ
int ColliderCount;
float ColliderBleed;
float ColliderEdgeSmooth; // 0..1

[numthreads(8, 8, 1)]
void BakeCollision(uint3 id : SV_DispatchThreadID)
{
    uint2 px = id.xy;
    uint w, h;
    CollisionRT.GetDimensions(w, h);
    if (px.x >= w || px.y >= h)
        return;

    float2 origin = float2(GridPosX, GridPosZ);
    float2 worldPos = float2((px.x + 0.5) * WorldSubW + origin.x, (px.y + 0.5) * WorldSubW + origin.y);

    float maxVal = 0.0;

    for (int i = 0; i < ColliderCount; i++)
    {
        float4 c = Colliders[i];
        float2 center = float2(c.x, c.y);
        float2 halfExt = float2(c.z, c.w);

        // distance from center
        float2 delta = abs(worldPos - center);

        // normalized distance to bleed boundary (0=center .. 1=at (halfExt+bleed))
        float2 nd = delta / (halfExt + ColliderBleed);
        float n = saturate(max(nd.x, nd.y));

        // shift smoothing start using ColliderEdgeSmooth (0..1)
        float start = max(0.0, 1.0 - ColliderEdgeSmooth); // e.g. Smooth=0.2 => start=0.8
        float t = saturate((n - start) / (1.0 - start + 1e-6));
        float val = 1.0 - t;

        maxVal = max(maxVal, val);
        if (maxVal >= 1.0)
            break;
    }

    CollisionRT[px] = float4(0.0, maxVal, 0.0, 1.0);
}


[numthreads(8, 8, 1)]
void GridCompute(uint3 id : SV_DispatchThreadID)
{
    uint2 px = id.xy;
    uint w, h;
    Result.GetDimensions(w, h);
    if (px.x >= w || px.y >= h)
        return;

    float2 origin = float2(GridPosX, GridPosZ);
    float2 worldPos = float2((px.x + 0.5) * WorldSubW + origin.x,
                             (px.y + 0.5) * WorldSubW + origin.y);

    // --- PLAYER ILLUMINATION ---
    int2 frontCell = int2(FrontCellX, FrontCellY);
    float2 center = (float2(frontCell) + 0.5) * Subdiv * WorldSubW + origin;

    float halfCell = (Subdiv * 0.5) * WorldSubW;
    float bleedMax = halfCell + PlayerIllumBleed;

    // distance du pixel au centre
    float2 delta = abs(worldPos - center);

    // zone bleed binaire : si pixel dans la zone bleed
    
    
        // distance normalisée pour le smoothing (0=center, 1=limite bleed)
        float n = max(delta.x / bleedMax, delta.y / bleedMax);

        // décalage start du smoothing
        float start = saturate(1.0 - PlayerCellEdgeSmooth);

        // illum : 1 au centre, 0 au bord du bleed
        float t = saturate((n - start) / (1.0 - start + 1e-6));
        float illum = 1.0 - t;

        // --- VISIBILITY ---
        float2 player2D = float2(PlayerPos.x, PlayerPos.z);
        float dist = distance(worldPos, player2D);
        float vis = 1.0 - smoothstep(VisibilityEdgeStart, VisibilityRadius, dist);

        // --- COLLISION ---
        int3 coord = int3(px.x, px.y, 0);
        float col = CollisionMask.Load(coord).g;

        Result[px] = float4(illum, vis, col, 1.0);
    

}







